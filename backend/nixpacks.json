{
  "phases": {
    "setup": {
      "nixPkgs": ["python311"]
    },
    "install": {
      "cmds": [
        "pip install --upgrade pip setuptools wheel",
        "pip install -r requirements.txt"
      ]
    }
  },
  "start": {
    "cmd": "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}

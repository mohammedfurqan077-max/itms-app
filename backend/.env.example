# Application Settings
APP_NAME=ITMS Backend
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Database (Railway will provide DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Update with your frontend URL)
ALLOWED_ORIGINS=https://your-frontend.railway.app,http://localhost:3000
ALLOWED_HOSTS=*

# Control System (Optional - for Raspberry Pi integration)
CONTROL_SYSTEM_URL=http://localhost:5000
CONTROL_SYSTEM_API_KEY=dev-api-key
CONTROL_SYSTEM_TIMEOUT=10

# Admin User (for initial setup)
ADMIN_EMAIL=admin@itms.com
ADMIN_PASSWORD=change-this-password

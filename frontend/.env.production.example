# Public browser-facing API base.
# Keep this as /api when using the built-in Next.js API proxy.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend API base URL used by src/pages/api/[...path].js on the hosting server.
# Example: https://your-backend.example.com/api
API_SERVER_URL=

# Browser-facing Socket.IO server URL.
# Example: https://your-backend.example.com
NEXT_PUBLIC_SOCKET_URL=
